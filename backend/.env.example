PORT=8000
MONGO_URI=mongodb://localhost:27017/eduhub
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Cloudinary Credentials (Get free from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gmail SMTP Credentials (for OTP emails via Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Groq AI API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key
